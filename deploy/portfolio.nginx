server {
    listen 443 ssl;
    server_name portfolio.49.247.40.177.sslip.io;
    ssl_certificate /srv/portfolio-ai-records/tls/live/portfolio-domain/fullchain.pem;
    ssl_certificate_key /srv/portfolio-ai-records/tls/live/portfolio-domain/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64m;
    location / {
        proxy_pass http://127.0.0.1:3120;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
