APP_URL=http://localhost:3000
PORT=3000
DATA_DIR=./data
# GitHub OAuth App callback: APP_URL/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Verified numeric ID returned by GitHub for Jochangheon; never infer from email.
ADMIN_GITHUB_ID=
# For environments using the platform HTTP proxy (Node >=24)
NODE_USE_ENV_PROXY=1

# Bind loopback behind nginx. Docker uses 0.0.0.0 inside its own network.
HOST=127.0.0.1
# Optional password authentication: scrypt salt:hash; never put a plaintext password here.
ADMIN_PASSWORD_HASH=
