{
  "name": "portfolio-ai-records",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node --import tsx tests/browser.ts",
    "build:preview": "vite build --config vite.preview.config.ts && node scripts/prepare-preview.mjs",
    "test:frontend": "node --import tsx tests/frontend.browser.ts",
    "preview": "npm run build:preview && vite preview --config vite.preview.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "build:site": "npm run build:preview && node scripts/export-site.mjs",
    "test:atlas": "node --import tsx tests/atlas.browser.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.0",
    "adm-zip": "^0.5.16",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^5.0.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
